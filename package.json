{
  "name": "jabar-fnb-scraper",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*"],
  "scripts": {
    "start": "node scraper.js",
    "scrape": "node --env-file=.env scraper.js",
    "sync": "node --env-file=.env apps/scraper/sync.js",
    "setup": "node scripts/setup.js",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "node --env-file=.env apps/backend/migrate.js",
    "dev": "node --env-file=.env scripts/dev.js",
    "build": "npm run build --workspace @prospek/frontend",
    "serve": "node --env-file=.env apps/backend/server.js",
    "test": "node --test review.test.js apps/backend/core.test.js",
    "test:integration": "node --env-file=.env apps/backend/integration.js",
    "browser": "playwright open --browser chromium --user-data-dir data/browser-profile https://www.google.com/maps/?hl=id"
  },
  "engines": { "node": ">=20" },
  "dependencies": { "playwright": "^1.55.0" }
}
